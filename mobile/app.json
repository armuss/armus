{
  "expo": {
    "name": "ARMUS",
    "slug": "armus",
    "owner": "xodeshes-team",
    "scheme": "armus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.armus.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Canlı ders odasına girmek için kameranı kullanmamız gerekiyor.",
        "NSMicrophoneUsageDescription": "Canlı ders odasında konuşabilmen için mikrofonunu kullanmamız gerekiyor."
      }
    },
    "android": {
      "package": "com.armus.app",
      "versionCode": 1,
      "permissions": ["CAMERA", "RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": ["expo-router", ["expo-notifications", { "color": "#e0a916" }]],
    "extra": {
      "eas": {
        "projectId": "a98f1a60-a9cc-4a3f-bae2-dff55825d12c"
      }
    }
  }
}
